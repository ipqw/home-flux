#!/usr/bin/env python3
"""
Управление доступами к VPN.

    tools/vpn list              показать всех и их ссылки
    tools/vpn add папа          завести человека
    tools/vpn remove папа       отозвать доступ
    tools/vpn apply             перегенерировать всё и выкатить

Скрипт делает всю работу целиком: правит список людей, пересобирает конфиг
Xray и файлы подписок, коммитит и пушит. Flux подхватывает изменения сам
в течение минуты.
"""
import argparse
import base64
import json
import pathlib
import secrets
import subprocess
import sys
import uuid
from urllib.parse import quote

ROOT = pathlib.Path(__file__).resolve().parent.parent
KEY = pathlib.Path.home() / "main/keys/flux-home.key"

try:
    import yaml
except ImportError:
    sys.exit("нужен PyYAML:  pip install --user pyyaml")


def run(cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, **kw)
    if r.returncode != 0:
        sys.exit(f"{' '.join(cmd)}:\n{r.stderr.strip()}")
    return r.stdout


def sops(args):
    env = {"SOPS_AGE_KEY_FILE": str(KEY), "PATH": "/usr/bin:/bin:/usr/local/bin", "HOME": str(pathlib.Path.home())}
    r = subprocess.run(["sops", *args], capture_output=True, text=True, cwd=ROOT, env=env)
    if r.returncode != 0:
        sys.exit(f"sops {' '.join(args)}:\n{r.stderr.strip()}")
    return r.stdout


def read_people():
    return yaml.safe_load(sops(["--decrypt", "people.yaml"]))


def write_people(data):
    p = ROOT / "people.yaml"
    p.write_text(yaml.safe_dump(data, allow_unicode=True, sort_keys=False), encoding="utf-8")
    sops(["--encrypt", "--in-place", "people.yaml"])


def vless_link(srv, person):
    params = (
        f"encryption=none&type=xhttp&path={quote('/', safe='')}"
        f"&host={srv['host']}&mode=auto&security=reality"
        f"&sni={srv['sni']}&fp=chrome&pbk={srv['publicKey']}"
        f"&sid={srv['shortId']}&spx={quote('/', safe='')}"
    )
    return f"vless://{person['uuid']}@{srv['host']}:{srv['port']}?{params}#{srv['profileTitle']}"


ROUTING = {
    "Name": "", "GlobalProxy": "true", "RouteOrder": "block-proxy-direct",
    "RemoteDNSType": "DoH", "RemoteDNSDomain": "", "RemoteDNSIP": "",
    "DomesticDNSType": "DoU", "DomesticDNSDomain": "", "DomesticDNSIP": "",
    "Geoipurl": "", "Geositeurl": "", "LastUpdated": "", "DnsHosts": {},
    "DirectSites": [
        "geosite:category-ru", "regexp:.*\\.ru", "geosite:yandex",
        "geosite:mailru", "geosite:apple", "geosite:microsoft", "geosite:google-play",
    ],
    "DirectIp": ["geoip:private", "geoip:ru"],
    "ProxySites": [], "ProxyIp": [],
    "BlockSites": ["geosite:category-ads-all"], "BlockIp": [],
    "DomainStrategy": "IPIfNonMatch", "FakeDNS": "false", "UseChunkFiles": "true",
}


def regenerate(data):
    """Пересобирает всё, что зависит от списка людей."""
    srv, people = data["server"], data["people"]
    if len({p["sub"] for p in people}) != len(people):
        sys.exit("токены подписок повторяются — доступы пересекутся")

    cfg_path = ROOT / "apps/vps/xray/config.yaml"
    doc = yaml.safe_load(sops(["--decrypt", "apps/vps/xray/config.yaml"]))
    xray = json.loads(doc["stringData"]["config.json"])
    xray["inbounds"][0]["settings"]["clients"] = [{"id": p["uuid"], "email": p["name"]} for p in people]
    doc["stringData"]["config.json"] = json.dumps(xray, ensure_ascii=False, indent=2) + "\n"
    cfg_path.write_text(yaml.safe_dump(doc, allow_unicode=True, sort_keys=False), encoding="utf-8")
    sops(["--encrypt", "--in-place", "apps/vps/xray/config.yaml"])

    subs_doc = {
        "apiVersion": "v1", "kind": "Secret",
        "metadata": {"name": "subs-content", "namespace": "subs"},
        "type": "Opaque",
        "stringData": {p["sub"]: base64.b64encode(vless_link(srv, p).encode()).decode() for p in people},
    }
    (ROOT / "apps/vps/subs/content.yaml").write_text(
        yaml.safe_dump(subs_doc, allow_unicode=True, sort_keys=False), encoding="utf-8")
    sops(["--encrypt", "--in-place", "apps/vps/subs/content.yaml"])

    routing_header = "happ://routing/add/" + base64.b64encode(
        json.dumps(ROUTING, ensure_ascii=False).encode()).decode()
    title_header = "base64:" + base64.b64encode(srv["profileTitle"].encode()).decode()
    nginx_conf = f"""server {{
  listen 8080;
  server_name _;

  error_page 404 = @notfound;
  location @notfound {{
    default_type text/html;
    return 404 '<html><head><title>404 Not Found</title></head><body><center><h1>404 Not Found</h1></center><hr><center>nginx</center></body></html>';
  }}

  location /sub/ {{
    alias /srv/sub/;
    default_type text/plain;
    add_header profile-title "{title_header}" always;
    add_header profile-update-interval "12" always;
    add_header subscription-userinfo "upload=0; download=0; total=0; expire=0" always;
    add_header routing "{routing_header}" always;
    add_header cache-control "no-store" always;
  }}

  location = / {{ return 404; }}
}}
"""
    (ROOT / "apps/vps/subs/nginx.yaml").write_text(
        yaml.safe_dump({
            "apiVersion": "v1", "kind": "ConfigMap",
            "metadata": {"name": "subs-nginx", "namespace": "subs"},
            "data": {"default.conf": nginx_conf},
        }, allow_unicode=True, sort_keys=False), encoding="utf-8")

    # Xray читает конфиг только при старте, а изменение секрета под не
    # перезапускает. Без смены этой строки коммит уедет, Flux отрапортует
    # успех, а работать будет старый список людей.
    for path, key in ((ROOT / "apps/vps/xray/deployment.yaml", "configVersion"),
                      (ROOT / "apps/vps/subs/deployment.yaml", "contentVersion")):
        text = path.read_text(encoding="utf-8")
        marker = f'{key}: "'
        i = text.index(marker) + len(marker)
        j = text.index('"', i)
        text = text[:i] + secrets.token_hex(4) + text[j:]
        path.write_text(text, encoding="utf-8")


def publish(message, push=True):
    run(["git", "add", "-A"])
    if not run(["git", "status", "--porcelain"]).strip():
        print("изменений нет")
        return
    run(["git", "-c", "user.name=ipqw", "-c", "user.email=naplesflorida2026@yahoo.com",
         "commit", "-q", "-m", message])
    if push:
        run(["git", "push", "-q", "origin", "main"])
        print("выкачено, Flux применит в течение минуты")
    else:
        print("закоммичено локально, не запушено")


def show(data):
    srv = data["server"]
    print(f"\n  сервер: {srv['host']}\n")
    for p in data["people"]:
        print(f"  {p['name']:<14} https://{srv['host']}/sub/{p['sub']}")
    print()


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("command", choices=["list", "add", "remove", "apply"])
    ap.add_argument("name", nargs="?")
    ap.add_argument("--no-push", action="store_true", help="не пушить в GitHub")
    a = ap.parse_args()

    data = read_people()
    names = [p["name"] for p in data["people"]]

    if a.command == "list":
        show(data)
        return

    if a.command == "apply":
        regenerate(data)
        publish("vpn: перегенерация конфигов", push=not a.no_push)
        show(data)
        return

    if not a.name:
        sys.exit(f"нужно имя:  tools/vpn {a.command} <имя>")

    if a.command == "add":
        if a.name in names:
            sys.exit(f"«{a.name}» уже есть")
        data["people"].append({
            "name": a.name,
            "uuid": str(uuid.uuid4()),
            "sub": secrets.token_urlsafe(12).replace("-", "x").replace("_", "y"),
        })
        write_people(data)
        regenerate(data)
        publish(f"vpn: доступ для {a.name}", push=not a.no_push)
        p = data["people"][-1]
        print(f"\n  {a.name}: https://{data['server']['host']}/sub/{p['sub']}\n")

    elif a.command == "remove":
        if a.name not in names:
            sys.exit(f"«{a.name}» нет в списке. Есть: {', '.join(names)}")
        data["people"] = [p for p in data["people"] if p["name"] != a.name]
        write_people(data)
        regenerate(data)
        publish(f"vpn: доступ отозван у {a.name}", push=not a.no_push)
        print(f"\n  доступ «{a.name}» больше не работает\n")


if __name__ == "__main__":
    main()
